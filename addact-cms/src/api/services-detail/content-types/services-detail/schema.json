{
  "kind": "collectionType",
  "collectionName": "services_details",
  "info": {
    "singularName": "services-detail",
    "pluralName": "services-details",
    "displayName": "Services Detail"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "listingContext": {
      "type": "component",
      "component": "home.base-component",
      "repeatable": false
    },
    "SEO": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "referenceTitle": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true
    },
    "ourPartner": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::our-partner.our-partner"
    },
    "whyaddact": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::global-card.global-card"
    },
    "faq": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::faq.faq"
    },
    "ourProcess": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::our-process.our-process"
    },
    "clientTestimonial": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::client-testimonial.client-testimonial"
    },
    "contactUs": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::form-field.form-field"
    },
    "industriesWeServe": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::industries-we-serve.industries-we-serve"
    },
    "ourInshightsTitle": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::common-title.common-title"
    },
    "industry": {
      "type": "component",
      "component": "home.industry-listing",
      "repeatable": false
    },
    "banner": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::banner.banner"
    },
    "cta": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::cta.cta"
    },
    "ourService": {
      "type": "dynamiczone",
      "components": [
        "home.service-list"
      ]
    }
